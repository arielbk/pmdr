{
  "name": "pmdr",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "setup": "pnpm install && pnpm build && pnpm --filter @arielbk/pmdr link --global",
    "release:pmdr": "node apps/cli/src/release.ts",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "menubar": "./scripts/menubar-run.sh",
    "menubar:gen": "./scripts/menubar-gen.sh",
    "menubar:zip": "./scripts/build-menubar-zip.sh"
  },
  "devDependencies": {
    "@arielbk/pmdr": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "ccusage": "18.0.11",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
